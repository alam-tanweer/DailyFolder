    private Book[] books;
    private int bookCount;


    public void addBook (Book book) {
        if (bookCount == books.length) {
            throw new IndexOutOfBoundsException ("Already have max books checked out.");
        }

        for (int i = 0; i < books.length; i++) {
            if (books[i] == null) {
                books[i] = book;
                bookCount++;
                return;
            }
        }
    }





