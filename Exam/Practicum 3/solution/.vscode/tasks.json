{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "DO NOT STOP - Auto Commit",
            "type": "shell",
            "windows": {
                "command": ".vscode/commit.cmd",
                "options": {
                    "shell": { 
                        "executable": "powershell.exe"
                    }
                }},
            "osx": {"command": ".vscode/commit.sh",
                "options": {
                    "shell": { 
                        "executable": "zsh"
                    }
                }},
            "linux": {"command": ".vscode/commit.sh",
                "options": {
                    "shell": { 
                        "executable": "zsh"
                    }
                }},
            "isBackground": true,
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "never"
            },
            "hide": true
        }
    ]
}